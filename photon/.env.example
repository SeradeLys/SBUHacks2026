# Copy this file to .env and fill in the values. Never commit .env (it is git-ignored).

# ---------- Required ----------
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
GEMINI_API=

# ---------- iMessage ----------
# The project's iMessage number with country code, like +15551234567 (used by self-service linking)
IMESSAGE_LINE=

# ---------- Hackathon demo mode (one preconfigured tester; see README) ----------
# DEMO_MODE=on
# The tester's exact iMessage handle: +15551234567 or an email
# DEMO_TESTER_HANDLE=
# The tester's website profile id (u_ + 40 hex), printed by the agent when their browser connects
# DEMO_TESTER_USER_ID=

# ---------- Optional ----------
# GEMINI_MODEL=
# WEB_CHAT=off
# WEB_CHAT_PORT=8787
# Comma-separated website addresses allowed to use web chat
# WEB_CHAT_ORIGINS=https://your-site.example
# LOG_MESSAGES=on   # prints message text and sender handles to the console; leave off normally
